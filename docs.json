{
  "theme": "mint",
  "name": "Mintlify Starter Kit",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "href": "mailto:hi@mintlify.com",
        "label": "Support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/how-we-use-it",
      "permanent": true
    }
  ],
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "icon": "book-open-cover",
          "href": "https://mintlify.com/docs"
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://mintlify.com/blog"
        }
      ]
    },
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "how-we-use-it"
        ]
      },
      {
        "group": "EOS",
        "icon": "compass",
        "pages": [
          "eos/overview",
          "eos/vision",
          "eos/people",
          {
            "group": "Scorecard",
            "icon": "chart-line",
            "pages": [
              "eos/data",
              "eos/growth/scorecard",
              "eos/scorecard/brand",
              "eos/scorecard/product"
            ]
          },
          "eos/issues",
          {
            "group": "Processes",
            "icon": "diagram-project",
            "pages": [
              "eos/process"
            ]
          },
          {
            "group": "Rocks",
            "icon": "bullseye-arrow",
            "pages": [
              "eos/traction",
              "eos/growth/rocks",
              "eos/rocks/brand",
              "eos/rocks/product"
            ]
          }
        ]
      }
    ]
  }
}
